{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.youtube",
  "name": "pocket-youtube",
  "title": "Pocket YouTube",
  "version": "0.2.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked", "input.buttons", "io.offload", "media.playback", "display.auxiliary", "input.touch.auxiliary"],
      "enhances": ["input.cursor", "input.analog.left", "input.analog.right"]
    }
  },
  "app": {
    "entry": "app/main.tsx",
    "output": "pocket-youtube",
    "framework": "solid",
    "viewport": { "fixed": { "logical": [400, 240], "presentation": "native" } },
    "surfaces": { "auxiliary": { "fixed": { "logical": [320, 240], "presentation": "native" } } }
  }
}
